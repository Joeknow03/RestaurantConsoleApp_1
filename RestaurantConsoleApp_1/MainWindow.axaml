<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RestaurantConsoleApp_1.MainWindow"
        Title="My Restaurant"
        Width="500" Height="600">

    <StackPanel Margin="20" Spacing="15">

        <TextBlock Text="My Restaurant" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

        <!-- Menu Selection -->
        <TextBlock Text="Menu" FontWeight="Bold" Margin="0,10,0,5"/>
        <StackPanel Orientation="Horizontal" Spacing="20">
            <RadioButton x:Name="ChickenRadio" Content="Chicken" IsChecked="True"/>
            <RadioButton x:Name="EggRadio" Content="Egg"/>
        </StackPanel>

        <!-- Quantity -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <TextBlock Text="Quantity" VerticalAlignment="Center"/>
            <TextBox x:Name="QuantityTextBox" Width="100" Text="1"/>
        </StackPanel>

        <!-- Buttons -->
        <Button Content="Submit new request" Click="SubmitNewRequest_Click" Width="200" HorizontalAlignment="Left"/>
        <Button Content="Copy the previous request" Click="CopyPreviousRequest_Click" Width="200" HorizontalAlignment="Left"/>

        <!-- Egg Quality Display -->
        <TextBlock x:Name="EggQualityText" Text="Egg Quality: " Margin="0,10,0,0"/>

        <Button Content="Prepare Food" Click="PrepareFood_Click" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"/>

        <!-- Results -->
        <TextBlock Text="Results" FontWeight="Bold" Margin="0,20,0,5"/>
        <TextBox x:Name="ResultsTextBox" 
                 Height="200" 
                 TextWrapping="Wrap" 
                 IsReadOnly="True"
                 AcceptsReturn="True"/>

    </StackPanel>
</Window>